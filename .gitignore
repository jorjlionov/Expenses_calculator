# ==========================================
# 1. СЕКРЕТЫ И КОНФИГУРАЦИЯ (САМОЕ ВАЖНОЕ!)
# ==========================================
.env
.env.local
.env.*.local
config.py # Если вы храните токены там, а не в .env

# ==========================================
# 2. БАЗЫ ДАННЫХ (SQLite)
# ==========================================
# Никогда не коммитьте реальные данные пользователей!
*.db
*.sqlite
*.sqlite3
data/
db/

# ==========================================
# 3. PYTHON (Стандартный набор)
# ==========================================
# Байт-компилированные файлы
__pycache__/
*.py[cod]
*$py.class

# Виртуальные окружения (они весят много и специфичны для ОС)
venv/
env/
.venv/
ENV/
env.bak/
venv.bak/

# Дистрибутивы и сборки
build/
dist/
*.egg-info/
.eggs/

# ==========================================
# 4. IDE И РЕДАКТОРЫ КОДА
# ==========================================
# PyCharm / IntelliJ
.idea/
*.iml

# VS Code
.vscode/
*.code-workspace

# ==========================================
# 5. ОПЕРАЦИОННЫЕ СИСТЕМЫ
# ==========================================
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ==========================================
# 6. ЛОГИ И ВРЕМЕННЫЕ ФАЙЛЫ
# ==========================================
*.log
logs/
temp/
tmp/